# Copy to backend/.env and fill in. Never commit .env.

# --- Database ------------------------------------------------------------------------------
# Supabase: Project → Connect → "Session pooler" URI (IPv4-friendly; the direct connection
# is IPv6-only on the free tier, which many home networks lack).
# Neon: the connection string from the dashboard (pooled or direct both work).
# Local Docker: postgresql://nocturne:nocturne@localhost:5432/nocturne
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Optional. If set, /chat and /ingest require the header  X-API-Key: <value>
API_KEY=

# --- LLMs ----------------------------------------------------------------------------------
GROQ_API_KEY=
# llama-3.3-70b-versatile was retired 2026-08-16. Check console.groq.com/docs/deprecations.
ONLINE_MODEL=openai/gpt-oss-120b
# low | medium | high for reasoning models; leave empty for non-reasoning models
ONLINE_REASONING_EFFORT=low

# Sleep-time LLM (Phase 2). gemini | openrouter
SLEEP_PROVIDER=gemini
GEMINI_API_KEY=
SLEEP_MODEL=gemini-2.5-flash
# OPENROUTER_API_KEY=

# --- Embeddings ----------------------------------------------------------------------------
# sentence-transformers (real) | hash (tests only, not semantic)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Tracing (optional; tracing is off when keys are blank) --------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
