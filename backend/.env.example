# Copy to backend/.env and fill in. Never commit .env.

# --- Database ------------------------------------------------------------------------------
# Supabase: Project → Connect → "Session pooler" URI (IPv4-friendly; the direct connection
# is IPv6-only on the free tier, which many home networks lack).
# Neon: the connection string from the dashboard (pooled or direct both work).
# Local Docker: postgresql://nocturne:nocturne@localhost:5432/nocturne
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Optional. If set, every endpoint except /health requires the header  X-API-Key: <value>
API_KEY=

# --- LLMs ----------------------------------------------------------------------------------
GROQ_API_KEY=
# llama-3.3-70b-versatile was retired 2026-08-16. Check console.groq.com/docs/deprecations.
ONLINE_MODEL=openai/gpt-oss-120b
# low | medium | high for reasoning models; leave empty for non-reasoning models
ONLINE_REASONING_EFFORT=low

# Sleep-time LLM. gemini | openrouter. Without a key, chat works and POST /sleep returns 503.
SLEEP_PROVIDER=gemini
GEMINI_API_KEY=
SLEEP_MODEL=gemini-2.5-flash
# OPENROUTER_API_KEY=

# --- Sleep cycle ---------------------------------------------------------------------------
# Runs automatically after SLEEP_IDLE_MINUTES idle with >= SLEEP_IDLE_MIN_EPISODES pending,
# or as soon as SLEEP_BACKLOG_EPISODES are pending. Set SLEEP_AUTO=false to only use /sleep.
SLEEP_AUTO=true
SLEEP_IDLE_MINUTES=10
SLEEP_IDLE_MIN_EPISODES=3
SLEEP_BACKLOG_EPISODES=30

# --- Embeddings ----------------------------------------------------------------------------
# fastembed (real; ONNX, no torch) | hash (tests only, not semantic)
# Switched from sentence-transformers in Phase 2: run `python -m scripts.reembed` once.
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Tracing (optional; tracing is off when keys are blank) --------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Evaluation (eval/run_eval.py) ---------------------------------------------------------
# A disposable database with "eval" in its name. It is WIPED before every benchmark
# conversation, so never use the DATABASE_URL above. docker compose creates this one:
# EVAL_DATABASE_URL=postgresql://nocturne:nocturne@localhost:5432/nocturne_eval
# The judge runs on its own quota bucket (on Groq, each model has separate limits).
# EVAL_JUDGE_PROVIDER=groq
# EVAL_JUDGE_MODEL=openai/gpt-oss-20b
# Raw-history budget for the full-context baseline. Raise it with a large-context answer
# model (EVAL_ANSWER_PROVIDER=sleep answers with the sleep model).
# EVAL_FULL_CONTEXT_TOKENS=5000
