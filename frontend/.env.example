# Where the backend runs.
VITE_API_URL=http://localhost:8000

# Accounts (leave empty for the single local memory). From Supabase: Project Settings → API.
# The publishable/anon key is meant for browsers; never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Extra sign-in buttons, if enabled under Authentication → Providers (comma-separated).
VITE_AUTH_PROVIDERS=
